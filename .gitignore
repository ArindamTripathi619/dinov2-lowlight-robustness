# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
dist/
build/
*.egg-info/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Virtual environments
.venv/
venv/
env/

# Datasets, model weights and local experiment artifacts are not versioned.
# (Committed result images under colab_results/ stay tracked via the negation.)
data/
output/**
!output/notebook1/
!output/notebook2/
# Corruption-family re-runs (Phase-1/2 per family) — figures/tables of record,
# referenced by the presentation gallery and RESEARCH §5.1; without these
# negations the deployed site's images were never committed.
!output/notebook1_blur/
!output/notebook1_contrast/
!output/notebook1_jpeg/
!output/notebook2_blur/
!output/notebook2_contrast/
!output/notebook2_jpeg/
logs/
*.png
!colab_results/**/*.png
!output/**/*.png
*.csv
!colab_results/**/*.csv
!output/**/*.csv
*.pth
*.pt

# Scratch logs from local runs (the small fixed-run LoRA log is the numeric
# artifact of record for the docs' Phase 3 tables and is explicitly tracked)
*.log
!colab_results/lora_run_fixed/lora_full_run.log

# Launcher scripts from local debugging
run_bg.sh
run_notebook1_bg.sh
run_notebook2_bg.sh
launch_nb2.sh

# Upstream snapshot used for the merge/rebase (reference copy, not repo content)
upstream_src/

# Result records under colab_results/ are versioned like sessionD's
!colab_results/**/*.log
!colab_results/**/*.json
!colab_results/**/*.pt

# sessionA: superseded duplicate adapter checkpoints (sessionD holds the arms of record)
colab_results/sessionA/

# Readout-repair results of record (dir sits under the output/** ignore)
!output/readout_repair/
!output/readout_repair/**

# Blur adapter re-evaluation results of record (same situation)
!output/blur_reeval/
!output/blur_reeval/**

# Track 1 drift-proxy results of record (same situation)
!output/drift_proxy/
!output/drift_proxy/**
!output/drift_proxy_dinov2_check/
!output/drift_proxy_dinov2_check/**
!output/drift_proxy_smoke/
!output/drift_proxy_smoke/**

# Track 2 v8 ViT-B drift-profile kernel results of record (same situation)
# Presentation app source
!apps/
!apps/**

# Static-site generated figures (tools/export_static_site.py — committed so the
# zero-config Vercel deploy has every chart)
!static/
!static/gen/
!static/gen/*.png

!output/vitb_profile/
!output/vitb_profile/**

# Track 2 v9 ViT-B LoRA-arm kernel results of record (same situation; adapter .pt
# checkpoints stay ignored — recoverable from the Kaggle kernel output)
!output/v9_lora/
!output/v9_lora/**
output/v9_lora/**/*.pt

# Track 2 v9 allocation-rule ablation kernel results of record (same situation;
# adapter .pt checkpoints stay ignored — recoverable from the Kaggle kernel output)
!output/v9_ablation/
!output/v9_ablation/**
output/v9_ablation/**/*.pt

# Track 3 cross-family drift-atlas results of record (drift-atlas-v4 kernel,
# 2026-10-14: 6 ImageNet + 2 CIFAR profile dirs, agreement reports, plots;
# atlas_cache pickles stay out — regenerated locally by --cache-dir)
!output/profiles/
!output/profiles/**
!output/atlas/
!output/atlas/**
!output/atlas_marks.log

# Track 4 SSR S1 results of record (ssr-s1 kernel, 2026-10-14: 4 model×corr
# dirs with results/meta/logs; marks log records the run incl. the
# verifier-name-bug false FAILED line — see METHODS §7.11)
!output/ssr/
!output/ssr/**
!output/ssr_marks.log

# Track 4 SSR S2 attachment-probe + S3 replication results of record
# (ssr-s2 / ssr-s3 kernels, 2026-10-15; verdicts METHODS §7.12/§7.13 —
# 32-leg S3 grid incl. per-leg ssr_results.csv / ssr_meta.json / ssr.log)
!output/ssr_s2/
!output/ssr_s2/**
!output/ssr_s2_marks.log
!output/ssr_s3/
!output/ssr_s3/**
!output/ssr_s3_marks.log
__pycache__/
*.pyc
.vercel
