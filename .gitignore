# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
dist/
build/
*.egg-info/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Virtual environments
.venv/
venv/
env/

# Datasets, model weights and local experiment artifacts are not versioned.
# (Committed result images under colab_results/ stay tracked via the negation.)
data/
output/**
!output/notebook1/
!output/notebook2/
logs/
*.png
!colab_results/**/*.png
!output/**/*.png
*.pth
*.pt

# Scratch logs from local runs
*.log

# Launcher scripts from local debugging
run_bg.sh
run_notebook1_bg.sh
run_notebook2_bg.sh
launch_nb2.sh
